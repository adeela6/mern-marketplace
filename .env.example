# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required. Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional (defaults to mongodb://localhost:27017/mernproject)
# MONGODB_URI=
# PORT=3000

# Stripe test keys: only needed for checkout and seller payouts
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
